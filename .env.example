# ---------------------------------------------------------------------------
# Firebase web config — copy the values from Firebase console → Project settings
# → Your apps → Web app. These are public identifiers (not secrets), but they
# are read from env from day one so staging/prod/emulator are just env changes.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Point the app at local emulators (npm run emulators). Leave unset in production.
# NEXT_PUBLIC_USE_EMULATORS=true

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
# Root domain members' gyms hang off, e.g. "gymli.app" → ironworks.gymli.app.
# Leave empty to run on a single domain; gyms are then selected via /g/<slug>.
NEXT_PUBLIC_ROOT_DOMAIN=
# Gym used when the host has no tenant subdomain (localhost, preview deploys).
NEXT_PUBLIC_DEFAULT_GYM_ID=demo

# Show "Demo member / Demo admin" buttons on the sign-in page (emulator/demo only).
# NEXT_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------------
# AI coach (server-side only — never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Without a key the coach falls back to a rules-based plan built from the same data.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
